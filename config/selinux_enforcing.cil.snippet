; SELinux Enforcing rules for vendor.oplus.hardware.charger.ICharger (V12 AIDL)
; Domain: hal_charger_oplus (runs as system:system)
; Append to /vendor/etc/selinux/vendor_sepolicy.cil if not already defined.

(type hal_charger_oplus)
(roletype object_r hal_charger_oplus)
(type hal_charger_oplus_exec)
(roletype object_r hal_charger_oplus_exec)
(type hal_charger_service)
(roletype object_r hal_charger_service)

(typeattributeset domain (hal_charger_oplus))
(typeattributeset halserverdomain (hal_charger_oplus))
(typeattributeset halclientdomain (hal_charger_oplus))
(typeattributeset file_type (hal_charger_oplus_exec))
(typeattributeset vendor_file_type (hal_charger_oplus_exec))
(typeattributeset exec_type (hal_charger_oplus_exec))
(typeattributeset service_manager_type (hal_charger_service))

(allow init_31_0 hal_charger_oplus_exec (file (read getattr map execute open)))
(allow init_31_0 hal_charger_oplus (process (transition)))
(allow hal_charger_oplus hal_charger_oplus_exec (file (read getattr map execute open entrypoint)))
(dontaudit init_31_0 hal_charger_oplus (process (noatsecure)))
(allow init_31_0 hal_charger_oplus (process (siginh rlimitinh)))
(typetransition init_31_0 hal_charger_oplus_exec process hal_charger_oplus)

(allow hal_charger_oplus servicemanager_31_0 (binder (call transfer)))
(allow servicemanager_31_0 hal_charger_oplus (binder (call transfer)))
(allow servicemanager_31_0 hal_charger_oplus (dir (search)))
(allow servicemanager_31_0 hal_charger_oplus (file (read open)))
(allow servicemanager_31_0 hal_charger_oplus (process (getattr)))
(allow hal_charger_oplus hal_charger_service (service_manager (add find)))
(allow hal_charger_oplus vendor_cos_bridge_prop (file (read getattr map open)))

(allow system_server_31_0 hal_charger_oplus (binder (call transfer)))
(allow hal_charger_oplus system_server_31_0 (binder (call transfer)))
(allow system_server_31_0 hal_charger_oplus (fd (use)))
(allow hal_charger_oplus system_server_31_0 (fd (use)))
(allow system_app_31_0 hal_charger_oplus (binder (call transfer)))
(allow hal_charger_oplus system_app_31_0 (binder (call transfer)))
(allow platform_app_31_0 hal_charger_oplus (binder (call transfer)))
(allow hal_charger_oplus platform_app_31_0 (binder (call transfer)))
(allow priv_app_31_0 hal_charger_oplus (binder (call transfer)))
(allow hal_charger_oplus priv_app_31_0 (binder (call transfer)))

; Sysfs read/write access for power_supply/battery, usb, bms
(allow hal_charger_oplus sysfs_battery_supply (dir (ioctl read getattr lock open search)))
(allow hal_charger_oplus sysfs_battery_supply (file (ioctl read write getattr lock append map open)))
(allow hal_charger_oplus sysfs_battery_supply (lnk_file (read getattr)))
(allow hal_charger_oplus sysfs_usb_supply (dir (ioctl read getattr lock open search)))
(allow hal_charger_oplus sysfs_usb_supply (file (ioctl read write getattr lock append map open)))
(allow hal_charger_oplus sysfs_usb_supply (lnk_file (read getattr)))
(allow hal_charger_oplus sysfs_batteryinfo_31_0 (dir (ioctl read getattr lock open search)))
(allow hal_charger_oplus sysfs_batteryinfo_31_0 (file (ioctl read write getattr lock append map open)))
(allow hal_charger_oplus sysfs_batteryinfo_31_0 (lnk_file (read getattr)))
(allow hal_charger_oplus sysfs_31_0 (dir (ioctl read getattr lock open search)))
(allow hal_charger_oplus sysfs_31_0 (file (ioctl read write getattr lock append map open)))
(allow hal_charger_oplus sysfs_31_0 (lnk_file (read getattr)))
